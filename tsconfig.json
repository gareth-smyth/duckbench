{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "node",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "./src",
    "baseUrl": "./",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "paths": {
      "*": ["*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "node_modules/vitest/globals.d.ts"
  ]
}
